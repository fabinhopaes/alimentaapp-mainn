{
  "expo": {
    "name": "Alimenta+",
    "slug": "alimenta-mais",
    "owner": "fabinhopaess-team",
    "scheme": "alimentamais",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/tabIcons/logo.png",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.alimentamais.tcc",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/tabIcons/logo.png",
        "backgroundColor": "#FFFCF6"
      }
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFCF6",
          "image": "./assets/images/tabIcons/logo.png",
          "imageWidth": 220
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d2fc7e2d-be32-407f-96fa-4bd4b20cbe6e"
      }
    }
  }
}
